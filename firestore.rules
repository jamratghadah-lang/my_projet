rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── الدوال المساعدة ───
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── responses: ردود المدعوين ───
    match /responses/{responseId} {
      allow create: if true
        && request.resource.data.keys().hasOnly([
             "name","phone","status","guests","style","eventSlug","entryCode",
             "personalCode","guestId","eventCode","companions","createdAt",
             "email","source","archived"
           ])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.status in ["yes", "no", "pending"]
        && request.resource.data.size() < 30;
      allow read, delete: if isSignedIn();
      // مسموح فقط للوحة التحكم (المالكة)، عشان تفعّل ميزة الأرشفة بدون فتح
      // التعديل لأي زائر غير مسجل دخول.
      allow update: if isSignedIn();
    }

    // ─── couples: روابط الدعوات المخصصة ───
    match /couples/{slug} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ─── settings: إعدادات لوحة التحكم ───
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── entry_card_locks: أقفال البطاقة الرقمية ───
    match /entry_card_locks/{slug} {
      // أول ضيف يطالب بالقفل لهالبطاقة
      allow create: if request.resource.data.keys().hasOnly(["slug","guestName","deviceId","claimedAt"])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.deviceId.size() < 100;
      // تحديث القفل مسموح فقط لنفس الجهاز اللي أخذه أول مرة (يمنع أي جهاز
      // ثاني من "سرقة" القفل عبر الكتابة المباشرة على القاعدة)
      allow update: if request.resource.data.keys().hasOnly(["slug","guestName","deviceId","claimedAt"])
        && request.resource.data.deviceId == resource.data.deviceId;
      allow read, delete: if isSignedIn();
    }

    // ─── guest_wall: تعليقات حائط الضيوف ───
    match /guest_wall/{commentId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isSignedIn();
    }

    // ─── checkins: سجل تسجيل الدخول يوم المناسبة ───
    // إنشاء: مفتوح (التطبيق يرسل بدون login)
    // القراءة والحذف: فقط لوحة التحكم المُسجّلة
    match /checkins/{checkinId} {
      allow create: if true;
      allow read, delete: if isSignedIn();
      allow update: if false;
    }

    // ─── deny by default ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
