rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── الدوال المساعدة ───
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── responses: ردود المدعوين ───
    match /responses/{responseId} {
      allow create: if true;
      allow read, delete: if isSignedIn();
      allow update: if false;
    }

    // ─── couples: روابط الدعوات المخصصة ───
    match /couples/{slug} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // ─── settings: إعدادات لوحة التحكم ───
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── entry_card_locks: أقفال البطاقة الرقمية ───
    match /entry_card_locks/{slug} {
      allow create, update: if true;
      allow read, delete: if isSignedIn();
    }

    // ─── guest_wall: تعليقات حائط الضيوف ───
    match /guest_wall/{commentId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isSignedIn();
    }

    // ─── checkins: سجل تسجيل الدخول يوم المناسبة ───
    // إنشاء: مفتوح (التطبيق يرسل بدون login)
    // القراءة والحذف: فقط لوحة التحكم المُسجّلة
    match /checkins/{checkinId} {
      allow create: if true;
      allow read, delete: if isSignedIn();
      allow update: if false;
    }

    // ─── deny by default ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
